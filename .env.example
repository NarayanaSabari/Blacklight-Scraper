NODE_ENV=production
PORT=3001
LOG_LEVEL=info

# Auto queue checker (enabled in production)
QUEUE_CHECK_INTERVAL_MS=30000
QUEUE_CHECK_STARTUP_DELAY_MS=5000

# Default location for per-platform search URLs.
# The backend no longer drives location-specific scraping (only role-based);
# each scraper instance falls back to this. Override per-instance to scope
# a machine to a tighter region (e.g. "California" or "New York, NY").
SCRAPER_DEFAULT_LOCATION=United States

# ── LinkedIn (RSC transport) ───────────────────────────────────────────────
# Results per request. Hard-capped at 50: LinkedIn answers with its
# no-results flag above that. Fewer, larger requests is the lower-exposure
# shape — dropping this raises the request COUNT, it does not reduce load.
LINKEDIN_RSC_COUNT=10
# How long a profile cookie jar is reused before re-reading it. Each read
# launches a browser briefly, so a short TTL means a launch per role.
LINKEDIN_RSC_COOKIE_TTL_MIN=30
# Captured once per host by `npm run linkedin:rsc-template`. Git-ignored;
# holds no credentials (cookies/csrf are stripped before writing).
LINKEDIN_RSC_TEMPLATE=config/linkedin-rsc-template.json
# On-disk persistent profile holding the logged-in session (npm run
# linkedin:login). Defaults to ~/.blacklight-linkedin-profile. Keep it intact.
# LINKEDIN_PROFILE_DIR=
# Post recency window: past-24h | past-week | past-month.
LINKEDIN_DATE_POSTED=past-24h
# Headless for the template capture. Default (unset) is HEADED, because
# headless is a detection signal on a real navigation.
# LINKEDIN_HEADLESS=
# How long LinkedIn is paused platform-wide after the session dies on a
# single-account host. Default 30 min.
# LINKEDIN_AUTH_COOLDOWN_MIN=30
# Fingerprint OS for per-account profiles: macos | windows | linux.
# Defaults to the HOST os — spoofing another leaks the real GPU.
# LINKEDIN_FINGERPRINT_PLATFORM=

# Proxy routing and platform-specific performance (all optional)
PROXY_LIST=
PROXY_LIST_FILE=config/proxies.txt
PROXY_EXCLUDE_PLATFORMS=glassdoor
PROXY_BLOCK_COOLDOWN_MS=600000
DICE_SEARCH_RENDER_WAIT_MS=2000
DICE_DETAIL_RENDER_WAIT_MS=0
DICE_DETAIL_CONCURRENCY=10
TECHFETCH_RETRY_BACKOFF_MS=500
TECHFETCH_DETAIL_CONCURRENCY=8
GLASSDOOR_WARMUP_ATTEMPTS=3
GLASSDOOR_WARMUP_BACKOFF_MS=1500
GLASSDOOR_MAX_AGE_DAYS=7
GLASSDOOR_FETCH_DESCRIPTIONS=true
GLASSDOOR_DESC_CONCURRENCY=6

# CloakBrowser session seats (one licence key per concurrent browser platform)
# Comma/newline separated; keep real keys out of git.
CLOAKBROWSER_LICENSE_KEYS=
# CLOAKBROWSER_LICENSE_KEYS_FILE=config/cloakbrowser-keys.txt
# CLOAKBROWSER_LICENSE_LOCK_DIR=

# Manual POST /scrape writes a per-platform JSON file to results/ for
# debugging — default OFF. The HTTP response already returns the full
# result, and results/ has no retention, so leaving this on unbounded-grows
# the disk on a long-lived host (a full disk breaks the LinkedIn profile
# flush on shutdown). Set to true only for a local debugging session, and
# clean up results/ yourself afterward.
SCRAPE_SAVE_RESULTS=false

# ── Observability ──────────────────────────────────────────────────────────
# Telemetry is proxied through the existing Blacklight scraper API, so
# no extra URL or API key is required — the scraper auto-picks up
# blacklight.apiUrl + blacklight.apiKey from credentials.json.
#
# Only set these if you want to override the defaults:

# Unique instance label (defaults to os.hostname()).
INSTANCE_ID=

# "daemon" for always-on machines (Pi, VPS) — alerts fire if silent > 5 min.
# "interactive" (default) for laptops — no offline alerts.
SCRAPER_MODE=interactive

# Treat a scrape that returns 0 jobs WITHOUT a positively-confirmed empty
# result as a failure (throws, cooldown, classified metric) instead of a
# silent success. Recommended ON for production hosts: a silent zero is how
# a broken scraper hides. Every platform now reports confirmed-empty, and
# LinkedIn additionally arms it at the registry level.
SCRAPER_STRICT_EMPTY=false

# Controls HEADLESS mode for Monster, Glassdoor, Glassdoor API enrichment, and
# TechFetch: unset/true = headless (default), false/0/no/off = headful.
# headless:true is a known Cloudflare/DataDome signal, so headful is an evasion
# lever to reach for if those sites start challenging. Needs a display on the
# host (or xvfb). On the Linux VM host (Monster, Dice, TechFetch), setting this
# headful also makes Monster headful and can break deployment without xvfb.
# Monster's persistent-profile launch uses MONSTER_HEADLESS separately; its
# other launch path uses SCRAPER_HEADLESS. Set both to control both paths.
# SCRAPER_HEADLESS=false
# MONSTER_HEADLESS=true

# Override the telemetry target / key (defaults to blacklight.apiUrl + apiKey).
# Handy for testing against a local backend.
TELEMETRY_URL=
TELEMETRY_KEY=

# Push cadence tuning.
METRICS_PUSH_INTERVAL_MS=30000
LOKI_PUSH_INTERVAL_MS=5000
LOKI_PUSH_BATCH_MAX=200
